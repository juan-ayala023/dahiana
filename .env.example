# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública de la app. En local: http://localhost:3000 · En Vercel: https://tu-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Acceso sin login (solo servidor, NUNCA con prefijo NEXT_PUBLIC_).
# Cuenta de la dueña en Supabase (creada con email confirmado) y clave del enlace
# personal: la app se abre con  <SITE_URL>/entrar/<ACCESS_KEY>
OWNER_EMAIL=
OWNER_PASSWORD=
ACCESS_KEY=
